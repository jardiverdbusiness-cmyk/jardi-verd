# Supabase — Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Email address that receives new lead notifications
CONTACT_TO_EMAIL=owner@example.com

# Optional: verified "from" address for outgoing emails (defaults to
# onboarding@resend.dev, which only works for testing). Once you verify a
# domain in Resend, set this to something like "Jardí Verd <hola@jardiverd.com>".
CONTACT_FROM_EMAIL="Jardí Verd <onboarding@resend.dev>"

# Public site URL, used for sitemap.xml and canonical/OG tags
NEXT_PUBLIC_SITE_URL=https://www.jardiverd.com
